# Identifiants du tableau de bord
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi
# Clé de signature des sessions (et de chiffrement des mots de passe si ENCRYPTION_KEY est vide)
SECRET_KEY=une-longue-chaine-aleatoire
# Optionnel : clé Fernet dédiée au chiffrement des mots de passe des bases
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Base interne (connexions, jobs, logs). SQLite par défaut, PostgreSQL possible :
# APP_DB_URL=postgresql+psycopg://user:pass@host:5432/sync_admin
APP_DB_URL=sqlite:///./data/app.db
APP_TIMEZONE=Africa/Dakar
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
BATCH_SIZE=5000
SCHEDULER_MAX_WORKERS=4
# Arrêt automatique d'une exécution qui dure plus de N minutes (0 = sans limite)
MAX_RUN_MINUTES=360
# Attente maximale d'un verrou PostgreSQL, en minutes (0 = sans limite)
LOCK_WAIT_MINUTES=10
# Relances automatiques après un arrêt automatique (0 = aucune). Si elles échouent toutes, le job est suspendu.
RETRY_MAX=3
RETRY_DELAY_MINUTES=2
# (ces valeurs par défaut peuvent être remplacées job par job dans le formulaire du job)
